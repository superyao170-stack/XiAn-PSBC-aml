# Copy to /www/wwwroot/bankgraph/environment/config/.env.production and fill secrets.
SERVER_PORT=3030

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=databank
DB_URL=jdbc:postgresql://127.0.0.1:5432/databank
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
SPRING_FLYWAY_BASELINE_VERSION=34
SPRING_FLYWAY_BASELINE_DESCRIPTION=Navicat_full_initialization_V34

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OUTBOX_TOPIC=bankgraph.business.events
OUTBOX_DISPATCH_DELAY_MS=5000

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=bankgraph
MINIO_BUCKET_NAME=bankgraph
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://SERVER_IP:9000

GRAPH_ACTIVE_ENGINE=tugraph
TUGRAPH_URI=bolt://127.0.0.1:7687
TUGRAPH_HOST=127.0.0.1
TUGRAPH_PORT=7687
TUGRAPH_REST_URL=http://127.0.0.1:7070
TUGRAPH_DATABASE=BankGraph
TUGRAPH_USERNAME=admin
TUGRAPH_PASSWORD=CHANGE_ME

WORKER_PYTHON=/www/wwwroot/bankgraph/workers/.venv/bin/python3
WORKER_CONCURRENCY=5
WORKER_QUEUE_CAPACITY=1000
STRUCTURED_CASE_WORKER_ROOT=/www/wwwroot/bankgraph/workers/structured-case-identification
AML_INTELLIGENCE_WORKER_ROOT=/www/wwwroot/bankgraph/workers/aml-intelligence

ANALYTICS_BASE_URL=http://127.0.0.1:18082

JWT_SECRET=CHANGE_TO_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
